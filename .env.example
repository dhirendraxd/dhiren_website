# EmailJS credentials for the Connect section contact form.
# Create a service + template at https://www.emailjs.com/, then set these
# in your local .env.local (gitignored) and in your host's environment
# variable settings (e.g. Netlify: Site settings -> Build & deploy -> Environment).
#
# The EmailJS template should expose {{name}}, {{email}}, and {{subject}}
# variables to match the fields sent from src/components/ConnectSection.tsx.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
